# Services à suivre : CSI=Nom du site (recommandé de le définir explicitement)
KEYYO_SERVICES=33175433361=Tana,33253359565=Antsirabe

# --- Fenêtre & filtres d'historique (pour 3 mois) ---
KEYYO_HISTORY_DAYS=92
KEYYO_AUTODISCOVER=1               # 1 = trouve seul le bon filtre pour ~3 mois (recommandé)
KEYYO_SEND_DATE_FILTERS=0          # 1 = forcer un filtre manuel (sinon auto-découverte)
KEYYO_DATE_FILTER_FORMAT=unix      # unix | date | datetime
KEYYO_FILTER_BEGIN=date_begin
KEYYO_FILTER_END=date_end
KEYYO_MAX_PAGES=50
KEYYO_LOCALIZED_NUMBERS=1
TZ=Europe/Paris

# --- Contacts : source(s) pour la résolution numéro -> nom ---
CONTACTS_SOURCE=both               # both | graph | keyyo
CONTACTS_PRIORITY=graph            # en cas de doublon : graph | keyyo
CONTACTS_DEFAULT_CC=33

