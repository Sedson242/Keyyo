# ============================================================
#  Keyyo Reporting — variables d'environnement (Vercel)
# ============================================================

# --- Auth Keyyo (Manager API, OAuth2) ---
KEYYO_CLIENT_ID=6a2407d6d65c9
KEYYO_CLIENT_SECRET=f7ef03477334f6fcda947896
KEYYO_REFRESH_TOKEN=65d74d92cc9e688e614d2072f893464e78b75712
KEYYO_TOKEN=                       # repli : access_token statique (~1h)
KEYYO_TOKEN_URL=https://api.keyyo.com/oauth2/token.php
KEYYO_API_BASE=https://api.keyyo.com/manager/1.0

# --- Lignes suivies ---
# auto (recommandé) = découverte de TOUTES les lignes du compte via GET /services
# -> les 3 lignes sont incluses sans rien coder. Vérifier sur /api/lines.
# Sinon, mapping explicite : CSI=Nom,CSI=Nom,CSI=Nom
KEYYO_SERVICES=auto
# KEYYO_SERVICES=33175433361=Tana,33253359565=Antsirabe,3375433361=Ligne3

# --- Base d'archivage (Vercel Blob) + synchro incrémentale ---
# Créer un Blob store : Vercel > Storage > Create Database > Blob > relier au projet
# -> BLOB_READ_WRITE_TOKEN est injecté automatiquement (rien à coller ici en prod).
BLOB_READ_WRITE_TOKEN=
KEYYO_HISTORY_DAYS=92              # 1er chargement : 3 mois d'historique
KEYYO_SYNC_DAYS=7                  # ensuite : on ne redemande que les derniers jours
KEYYO_RETENTION_DAYS=0             # 0 = la base garde TOUT (aucune purge)
CRON_SECRET=                       # optionnel : protège /api/sync (Vercel l'envoie au cron)

# --- Fenêtre & filtres d'historique (format OFFICIEL doc Keyyo) ---
# date_start / date_end au format "YYYY-MM-DD HH:MM" + pagination limit/offset.
KEYYO_FILTER_BEGIN=date_start
KEYYO_FILTER_END=date_end
KEYYO_PAGE_LIMIT=500
KEYYO_MAX_PAGES=50
KEYYO_LOCALIZED_NUMBERS=1
TZ=Europe/Paris

# --- Contacts : source(s) pour la résolution numéro -> nom ---
CONTACTS_SOURCE=both               # both | graph | keyyo
CONTACTS_PRIORITY=graph            # en cas de doublon : graph | keyyo
CONTACTS_DEFAULT_CC=33

# Microsoft Graph (Outlook)
GRAPH_TENANT_ID=c21cd161-570d-4f7e-81ac-bc2a2d8963c4
GRAPH_CLIENT_ID=84c54438-d738-498f-aa9c-b16c0957b8b3
GRAPH_CLIENT_SECRET=hFK8Q~ZRt3ATjdhB27unkehxTyS6Lg29NcgLfa5A
GRAPH_CONTACTS_USER=plecorre@bios-expertise.com               # UPN du propriétaire du carnet partagé
GRAPH_CONTACTS_FOLDER=             # nom du dossier (ex: Clients), optionnel
GRAPH_CONTACTS_FOLDER_ID=          # ou son id, optionnel
