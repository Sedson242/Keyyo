# === Authentification Keyyo (OAuth2) ===
# Mode recommandé : refresh_token (renouvelle l'access_token automatiquement).
KEYYO_CLIENT_ID=
KEYYO_CLIENT_SECRET=
KEYYO_REFRESH_TOKEN=
# Repli optionnel : access_token statique (expire ~1h) si pas de refresh_token.
KEYYO_TOKEN=
KEYYO_TOKEN_URL=https://api.keyyo.com/oauth2/token.php

# === API ===
KEYYO_API_BASE=https://api.keyyo.com/manager/1.0
# IMPORTANT : les clés sont les CSI (identifiants de service Keyyo), PAS forcément
# les numéros de téléphone. Vérifier les CSI réels via /api/debug (bloc A_services).
KEYYO_SERVICES=33175433361=Tana,33253359565=Antsirabe

# === Fenêtre & filtres (à ajuster si 0 appel) ===
KEYYO_HISTORY_DAYS=120
# 1 = envoyer les filtres de date ; 0 = laisser Keyyo décider (utile pour tester)
KEYYO_SEND_DATE_FILTERS=1
# Format des bornes : date (YYYY-MM-DD) | datetime (YYYY-MM-DD HH:MM:SS) | unix
KEYYO_DATE_FILTER_FORMAT=date
KEYYO_FILTER_BEGIN=date_begin
KEYYO_FILTER_END=date_end
KEYYO_RESOURCE_PATH=services/{csi}/{resource}
KEYYO_MAX_PAGES=50
KEYYO_LOCALIZED_NUMBERS=1

# 1 = valider les CSI contre /services au démarrage (diagnostic)
KEYYO_VALIDATE_CSI=0

TZ=Europe/Paris
