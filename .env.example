# =============================================================================
#  Supervision des appels Keyyo — variables d'environnement
# =============================================================================
#
#  /!\  AVERTISSEMENT DE SÉCURITÉ — À TRAITER AVANT TOUT DÉPLOIEMENT  /!\
#
#  La version précédente de ce projet contenait de VRAIS secrets en clair,
#  commités dans git : identifiant client, secret client et refresh token
#  Keyyo (dans son .env.example ET en valeurs par défaut codées en dur dans
#  api/_keyyo.js), ainsi qu'un secret client Azure AD.
#
#  Un secret présent dans l'historique git reste récupérable même après
#  suppression du fichier. Ces quatre secrets doivent donc être considérés
#  comme compromis et RÉGÉNÉRÉS :
#    1. console Keyyo  -> régénérer client secret + refresh token
#    2. portail Azure  -> révoquer le secret client de l'app (devenu inutile :
#                         cette version n'utilise plus Microsoft Graph)
#
#  Ce fichier ne contient que des EXEMPLES. Il est suivi par git : n'y écrivez
#  jamais une valeur réelle. Les vraies valeurs se saisissent dans
#  Vercel > Project > Settings > Environment Variables, ou en local dans
#  .env.local (ignoré par git).
#
# =============================================================================


# -----------------------------------------------------------------------------
#  1. Authentification Keyyo — OBLIGATOIRE
# -----------------------------------------------------------------------------
#  Flot OAuth2 « refresh_token » : les trois variables ci-dessous vont ensemble.
#  Le scope « full_access_read_only » suffit — cet outil ne fait que lire.
#  Le refresh token peut être rotatif : l'application suit automatiquement le
#  nouveau jeton quand Keyyo en renvoie un, pour la durée de vie du processus.

KEYYO_CLIENT_ID=votre_identifiant_client
KEYYO_CLIENT_SECRET=votre_secret_client
KEYYO_REFRESH_TOKEN=votre_refresh_token

#  Repli : un jeton d'accès déjà obtenu. Il expire en ~1 h, donc réservé au
#  dépannage ponctuel — jamais pour un déploiement durable.
#  (Le code lit bien KEYYO_ACCESS_TOKEN, et non KEYYO_TOKEN.)
KEYYO_ACCESS_TOKEN=

#  Points d'entrée de l'API. À ne changer que si Keyyo les fait évoluer.
KEYYO_API_BASE=https://api.keyyo.com/manager/1.0
KEYYO_TOKEN_URL=https://api.keyyo.com/oauth2/token.php


# -----------------------------------------------------------------------------
#  2. Fenêtre d'historique
# -----------------------------------------------------------------------------
#  Profondeur visée au premier remplissage, en jours. 92 ≈ les trois derniers
#  mois, qui est le périmètre demandé.
KEYYO_HISTORY_DAYS=92

#  Ensuite, chaque synchronisation ne redemande que les N derniers jours et
#  fusionne dans l'archive. Garder une marge : un appel peut être consolidé
#  côté Keyyo avec quelques jours de retard.
KEYYO_SYNC_DAYS=7

#  Purge de l'archive, en jours. 0 = on ne purge JAMAIS : c'est la vocation de
#  l'archive, puisque l'API Keyyo a une fenêtre glissante. Au fil des mois
#  l'historique dépassera donc les trois mois, sans limite.
KEYYO_RETENTION_DAYS=0


# -----------------------------------------------------------------------------
#  3. Archive (Vercel Blob) — fortement recommandée
# -----------------------------------------------------------------------------
#  Sans archive, l'outil fonctionne mais SANS MÉMOIRE : les appels sortis de la
#  fenêtre glissante de l'API sont définitivement perdus.
#
#  Mise en place : Vercel > projet > Storage > Create Database > Blob, puis
#  relier le store au projet. BLOB_READ_WRITE_TOKEN est alors injecté
#  automatiquement — rien à coller ici en production.
BLOB_READ_WRITE_TOKEN=

#  Force l'usage de l'archive même si le jeton semble absent. Dépannage
#  uniquement, laisser vide.
KEYYO_FORCE_BLOB=


# -----------------------------------------------------------------------------
#  4. Réglages de collecte
# -----------------------------------------------------------------------------
#  Taille de page demandée à Keyyo (paramètre `limit`).
KEYYO_PAGE_LIMIT=200

#  Plafond de pages par relevé, garde-fou contre une pagination sans fin.
#  Si le diagnostic signale des relevés « tronqués », augmenter cette valeur
#  ou collecter mois par mois avec /api/sync?month=AAAA-MM.
KEYYO_MAX_PAGES=40

#  Budget de temps d'une collecte, en millisecondes. Doit rester SOUS le
#  maxDuration déclaré dans vercel.json (30 000 ms), marge comprise : au-delà
#  du budget la collecte rend ce qu'elle a déjà au lieu d'échouer.
KEYYO_BUDGET_MS=24000

#  Fuseau d'affichage. Toutes les dates et heures de l'interface sont calculées
#  dans ce fuseau — c'est l'heure à laquelle le téléphone a réellement sonné.
#  Un format POSIX du type « :UTC » est toléré et nettoyé automatiquement.
TZ=Europe/Paris


# -----------------------------------------------------------------------------
#  5. Rapprochement ligne -> collaborateur (le prénom affiché)
# -----------------------------------------------------------------------------
#  L'application déduit seule qui est derrière chaque ligne, en croisant
#  /directory_contacts, /services?type=EmailAccount et /services?type=UCaaSVoIPAccount
#  (voir docs/MAPPING-IDENTITES.md).
#
#  Cette variable sert à FORCER À LA MAIN les lignes qu'elle n'a pas réussi à
#  associer. Elle est souveraine sur toutes les règles automatiques.
#  Format : CSI=adresse@domaine, séparés par des virgules. Le format JSON
#  { "CSI": "adresse@domaine" } est également accepté.
#
#  La page Diagnostic affiche la ligne exacte à coller ici, déjà remplie avec
#  les CSI non résolus : inutile de la composer à la main.
KEYYO_LINE_EMAILS=


# -----------------------------------------------------------------------------
#  6. Protection du cron
# -----------------------------------------------------------------------------
#  Quand cette variable est définie, /api/sync exige l'en-tête
#  « Authorization: Bearer <CRON_SECRET> ». Vercel l'envoie automatiquement à
#  ses propres crons. Recommandé : /api/sync ne divulgue aucune donnée d'appel,
#  mais il consomme du quota API à chaque appel.
#  Générer une valeur aléatoire longue (32 caractères ou plus).
CRON_SECRET=
